{
  "name": "nuxt-fullstack-starter",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "run-s env.touch env.dev prepare",
    "env.touch": "rimraf .env && cp .env.example .env && printf \"INFISICAL_TOKEN=$BINOCORP_INFISICAL_TOKEN\n\" >> .env",
    "env.dev": "dotenv -- run-p env.dev.*",
    "env.dev.common": "dotenv -- infisical export --env=dev --path=/ >> .env --projectId 26631d7e-97f4-4246-ad64-511de8da3ae7",
    "env.dev.local": "dotenv -- infisical export --env=dev --path=/nuxt-fullstack-starter >> .env --projectId 26631d7e-97f4-4246-ad64-511de8da3ae7",
    "build": "nuxt build",
    "prepare": "run-s prepare.*",
    "prepare.nuxt": "dotenv -- nuxt prepare",
    "dev": "dotenv -- nuxt dev",
    "check": "dotenv -- nuxt typecheck",
    "generate": "nuxt generate",
    "preview": "dotenv -- run-s build preview.only",
    "preview.only": "npx wrangler dev .output/server/index.mjs --assets .output/public --port $PORT --https-key-path=./localhost-key.pem --https-cert-path=./localhost.pem --local-protocol https",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "story:preview": "histoire preview",
    "db:generate": "dotenv -- run-s db:generate.*",
    "db:generate.better-auth": "dotenv -- npx @better-auth/cli@1.3.34 generate --config ./src/server/lib/auth.generator.ts --output ./src/server/database/schema/better-auth.schema.ts -y",
    "db:generate.drizzle": "dotenv -- drizzle-kit generate",
    "db:migrate": "dotenv -- run-s db:generate db:migrate.*",
    "db:migrate.only": "dotenv -- drizzle-kit migrate",
    "db:migrate.push": "dotenv -- drizzle-kit push",
    "db:studio": "dotenv -- drizzle-kit studio --config=./drizzle.config.ts",
    "deploy": "run-s build deploy.*",
    "deploy.only": "dotenv -- wrangler deploy"
  },
  "dependencies": {
    "@bino0216/nitro-cloudflare-dev": "workspace:*",
    "@ionic/vue": "^8.7.11",
    "@nuxt/eslint": "^1.11.0",
    "@nuxt/ui": "^4.2.1",
    "@pinia/colada": "^0.17.9",
    "@pinia/colada-nuxt": "^0.2.4",
    "@pinia/nuxt": "^0.11.3",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vueuse/core": "^14.1.0",
    "@vueuse/nuxt": "^14.1.0",
    "better-auth": "^1.4.4",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.44.7",
    "drizzle-valibot": "^0.4.2",
    "eslint": "^9.39.1",
    "nuxt": "4.1.3",
    "pinia": "^3.0.4",
    "postgres": "^3.4.7",
    "sass": "^1.94.2",
    "superjson": "^2.2.6",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.2.0",
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "^1.0.0-alpha.5",
    "@nuxt/types": "^2.18.1",
    "@types/node": "^24.10.1",
    "dotenv-cli": "^11.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "histoire": "^1.0.0-alpha.5",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.2",
    "typescript": "^5.6.3",
    "vue-tsc": "^3.1.7"
  }
}
